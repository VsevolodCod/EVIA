# mock | ollama | openai
LLM_PROVIDER=mock
LLM_MODEL=
THINKING=0
TIMEOUT=120
# сколько токеновв может сгенерить модель за 1 ответ.
# -1 для неограниченного выхода
MAX_TOKENS_G=256

# OpenAI-compatible Chat Completions API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Ollama API (Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Increase to 60m for a local test session to avoid repeated cold loads.
OLLAMA_KEEP_ALIVE=10m

BI_DATA_DIR=./data
CHAT_DB_PATH=data/chats.db
CATALOG_DB_PATH=data/catalog.db

AGENT_MAX_STEPS=5
# Повторные запросы к LLM на уровне агента
LLM_RETRY_MAX_ATTEMPTS=5
LLM_RETRY_BASE_DELAY=0.3
LLM_RETRY_BACKOFF_MULTIPLIER=2.0
LLM_RETRY_MAX_DELAY=5.0