{
  "$defs": {
    "ColumnProfile": {
      "additionalProperties": false,
      "description": "Sample facts plus statistics calculated across an exact snapshot.",
      "properties": {
        "distinct_count": {
          "minimum": 0,
          "title": "Distinct Count",
          "type": "integer"
        },
        "distinct_sample_values": {
          "minimum": 0,
          "title": "Distinct Sample Values",
          "type": "integer"
        },
        "empty_count": {
          "minimum": 0,
          "title": "Empty Count",
          "type": "integer"
        },
        "is_identifier_candidate": {
          "title": "Is Identifier Candidate",
          "type": "boolean"
        },
        "non_null_count": {
          "minimum": 0,
          "title": "Non Null Count",
          "type": "integer"
        },
        "null_count": {
          "minimum": 0,
          "title": "Null Count",
          "type": "integer"
        },
        "numeric": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sample_non_null_count": {
          "minimum": 0,
          "title": "Sample Non Null Count",
          "type": "integer"
        },
        "sample_null_count": {
          "minimum": 0,
          "title": "Sample Null Count",
          "type": "integer"
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "top_values": {
          "items": {
            "$ref": "#/$defs/TopValue"
          },
          "title": "Top Values",
          "type": "array"
        },
        "top_values_coverage": {
          "const": "sample",
          "title": "Top Values Coverage",
          "type": "string"
        },
        "uniqueness_ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Uniqueness Ratio",
          "type": "number"
        }
      },
      "required": [
        "sample_non_null_count",
        "sample_null_count",
        "distinct_sample_values",
        "top_values",
        "non_null_count",
        "null_count",
        "empty_count",
        "distinct_count",
        "uniqueness_ratio",
        "is_identifier_candidate",
        "top_values_coverage"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "DatasetSnapshot": {
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "row_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Count"
        },
        "schema_version": {
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "importing",
            "ready",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "snapshot_id",
        "schema_version",
        "content_sha256",
        "created_at",
        "state"
      ],
      "title": "DatasetSnapshot",
      "type": "object"
    },
    "FullProfile": {
      "additionalProperties": false,
      "description": "Profile with exact statistics for an immutable CSV snapshot.",
      "properties": {
        "candidate_grain_keys": {
          "items": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "title": "Candidate Grain Keys",
          "type": "array"
        },
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/ColumnProfile"
          },
          "title": "Columns",
          "type": "object"
        },
        "coverage": {
          "const": "full",
          "title": "Coverage",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "processed_rows": {
          "minimum": 0,
          "title": "Processed Rows",
          "type": "integer"
        },
        "sample_limit": {
          "minimum": 1,
          "title": "Sample Limit",
          "type": "integer"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "sample_size",
        "sample_limit",
        "processed_rows",
        "coverage",
        "snapshot_id",
        "columns",
        "note"
      ],
      "title": "FullProfile",
      "type": "object"
    },
    "NumericProfile": {
      "properties": {
        "average": {
          "title": "Average",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "maximum": {
          "title": "Maximum",
          "type": "string"
        },
        "minimum": {
          "title": "Minimum",
          "type": "string"
        },
        "total": {
          "title": "Total",
          "type": "string"
        }
      },
      "required": [
        "count",
        "minimum",
        "maximum",
        "total",
        "average"
      ],
      "title": "NumericProfile",
      "type": "object"
    },
    "SampleColumnProfile": {
      "additionalProperties": false,
      "description": "Facts calculated only from a bounded sample.",
      "properties": {
        "distinct_sample_values": {
          "minimum": 0,
          "title": "Distinct Sample Values",
          "type": "integer"
        },
        "sample_non_null_count": {
          "minimum": 0,
          "title": "Sample Non Null Count",
          "type": "integer"
        },
        "sample_null_count": {
          "minimum": 0,
          "title": "Sample Null Count",
          "type": "integer"
        },
        "top_values": {
          "items": {
            "$ref": "#/$defs/TopValue"
          },
          "title": "Top Values",
          "type": "array"
        }
      },
      "required": [
        "sample_non_null_count",
        "sample_null_count",
        "distinct_sample_values",
        "top_values"
      ],
      "title": "SampleColumnProfile",
      "type": "object"
    },
    "SampleProfile": {
      "additionalProperties": false,
      "description": "Profile whose facts are limited to a bounded live PostgreSQL sample.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "$ref": "#/$defs/SampleColumnProfile"
          },
          "title": "Columns",
          "type": "object"
        },
        "coverage": {
          "const": "sample",
          "title": "Coverage",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "sample_limit": {
          "minimum": 1,
          "title": "Sample Limit",
          "type": "integer"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        }
      },
      "required": [
        "sample_size",
        "sample_limit",
        "coverage",
        "columns",
        "note"
      ],
      "title": "SampleProfile",
      "type": "object"
    },
    "TemporalProfile": {
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "maximum": {
          "title": "Maximum",
          "type": "string"
        },
        "minimum": {
          "title": "Minimum",
          "type": "string"
        }
      },
      "required": [
        "count",
        "minimum",
        "maximum"
      ],
      "title": "TemporalProfile",
      "type": "object"
    },
    "TopValue": {
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "count"
      ],
      "title": "TopValue",
      "type": "object"
    }
  },
  "$id": "urn:evia:contracts:1.0:Profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A response that distinguishes exact snapshot facts from sample facts.",
  "discriminator": {
    "mapping": {
      "full": "#/$defs/FullProfile",
      "sample": "#/$defs/SampleProfile"
    },
    "propertyName": "coverage"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/FullProfile"
    },
    {
      "$ref": "#/$defs/SampleProfile"
    }
  ],
  "title": "Profile"
}
